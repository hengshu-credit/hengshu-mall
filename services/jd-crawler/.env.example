# Match the running mall Docker network (docker network ls).
MALL_NETWORK=crmeb-mall_default
# Optional: empty credentials are generated on first start and kept in crawler-data.
JD_CRAWLER_TOKEN=
# VNC authentication uses exactly eight characters; login is only exposed on host loopback.
JD_VNC_PASSWORD=
JD_LOGIN_PORT=6080
JD_CRAWLER_JOB_TIMEOUT=240
JD_DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
JD_DEBIAN_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security
JD_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
JD_PYTHON_IMAGE=python:3.12-slim-bookworm
