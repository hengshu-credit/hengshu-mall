# Copy to .env beside compose.yml and fill all three passwords before starting.
# Use different random passwords of at least 24 letters/digits (no quotes needed).
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=
BIND_IP=0.0.0.0
HTTP_PORT=8011
# JD credentials are generated in the service volume on first startup.
JD_LOGIN_PORT=6080
JD_CRAWLER_JOB_TIMEOUT=240
# Optional build sources; the default download sources are domestic HTTPS mirrors.
JD_DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
JD_DEBIAN_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security
JD_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# Use a Python 3.12 slim-bookworm image in your own registry if Docker Hub is slow.
JD_PYTHON_IMAGE=python:3.12-slim-bookworm
