# Copy to .env beside compose.yml and fill all three passwords before starting.
# Use different random passwords of at least 24 letters/digits (no quotes needed).
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=
BIND_IP=0.0.0.0
HTTP_PORT=8011
# JD credentials are generated in the service volume on first startup.
JD_LOGIN_PORT=6080
JD_CRAWLER_JOB_TIMEOUT=240
